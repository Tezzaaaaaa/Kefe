{
  "name": "KEFE Visualiser",
  "short_name": "KEFE",
  "description": "Browser-based lyric video and music visualiser editor.",
  "id": "./editor.html",
  "start_url": "./editor.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#171719",
  "theme_color": "#171719",
  "categories": ["music", "multimedia", "productivity"],
  "icons": [
    { "src": "app/brand/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "app/brand/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "app/brand/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "app/brand/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
