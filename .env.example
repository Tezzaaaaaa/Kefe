# Copy this file to .env and fill in real values before running the server.

# Random long string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Your live site URL (used for Stripe redirect + billing portal return URLs).
# Use http://localhost:3000 while testing locally.
APP_URL=http://localhost:3000

PORT=3000

# --- Stripe ---
# From https://dashboard.stripe.com/apikeys (use the "sk_live_..." key when you go live,
# "sk_test_..." while testing).
STRIPE_SECRET_KEY=

# The Price ID of your Pro subscription plan, from
# https://dashboard.stripe.com/products -> your product -> pricing.
# Looks like "price_1AbCdEfGhIjKlMnOp".
STRIPE_PRICE_ID=

# From https://dashboard.stripe.com/webhooks after you add an endpoint pointing at
# https://YOURDOMAIN.com/api/billing/webhook (see DEPLOY.md).
STRIPE_WEBHOOK_SECRET=

# How many days of full Pro access a new signup gets before dropping to Free.
TRIAL_DAYS=7

# --- Caption Generator: optional server-side speech transcription ---
# Powers the "KEFE server API" engine in the browser Caption Generator.
# Any OpenAI-compatible transcription endpoint works. The key lives ONLY here
# on the server — it is never exposed to the browser. Leave TRANSCRIBE_API_KEY
# empty to disable the route (it responds 501 and the UI suggests the local
# in-browser Whisper engine instead).
TRANSCRIBE_API_KEY=
TRANSCRIBE_API_URL=https://api.openai.com/v1/audio/transcriptions
TRANSCRIBE_MODEL=whisper-1

# --- Foreground cutout: self-hosted Lucida ---
# URL of the KEFE Lucida inference service. Keep this server-side.
# Local default: http://127.0.0.1:8756
LUCIDA_URL=http://127.0.0.1:8756
