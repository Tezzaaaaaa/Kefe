(function(){
  function update(){
    if (!document.body.classList.contains('wizard-mode')) return;
    var step = document.body.dataset.wizardStep;
    if (step !== 'background') {
      var existing = document.getElementById('kefeDebugBox');
      if (existing) existing.remove();
      return;
    }
    var box = document.getElementById('kefeDebugBox');
    if (!box) {
      box = document.createElement('div');
      box.id = 'kefeDebugBox';
      box.style.cssText = 'position:fixed;bottom:12px;right:12px;z-index:999999;background:#001a00;color:#0f0;font:11px monospace;padding:10px;border:2px solid #0f0;border-radius:6px;max-width:340px;white-space:pre-wrap;line-height:1.4';
      document.body.appendChild(box);
    }
    var bg = document.getElementById('backgroundSection');
    var sidebar = document.querySelector('.sidebar');
    var lines = [
      'step: ' + step,
      'bg exists: ' + !!bg,
      'bg parent id: ' + (bg && bg.parentElement ? (bg.parentElement.id || bg.parentElement.className) : 'none'),
      'bg parent is sidebar: ' + (bg && sidebar ? bg.parentElement === sidebar : false),
      'bg child count: ' + (bg ? bg.children.length : 0),
      'bg display: ' + (bg ? getComputedStyle(bg).display : 'n/a'),
      'bg class: ' + (bg ? bg.className : 'n/a'),
      'sidebar has: ' + (sidebar ? Array.from(sidebar.children).map(function(c){return c.id || c.className.split(' ')[0];}).join(', ') : 'n/a')
    ];
    box.textContent = lines.join('\n');
  }
  setInterval(update, 150);
})();
