{
  "name": "kefe-visualiser",
  "version": "1.1.0",
  "private": true,
  "description": "KEFE Visualiser — browser-based lyric video creation with music intelligence, effect modules, membership tiers and local MP4 export.",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "check": "node --check server/index.js && node --check server/auth.js && node --check server/billing.js && node --check server/db.js && node --check server/entitlements.js && node --check serv[...]",
    "test:smoke": "node tests/smoke.mjs",
    "test:functional": "node tests/functional-sweep.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky && chmod +x .husky/pre-commit",
    "lint:slop": "slop-scan scan . --lint",
    "check:overengineer": "slop-scan scan . --lint",
    "check:ai-change": "node scripts/ai-change-guard.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "stripe": "^16.12.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "playwright": "^1.55.0",
    "prettier": "^3.6.2",
    "slop-scan": "^0.3.0"
  },
  "engines": {
    "node": ">=18"
  }
}
